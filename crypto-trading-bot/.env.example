# Exchange
EXCHANGE=binance
TRADING_MODE=paper
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Trading
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
MAX_CONCURRENT_POSITIONS=3
POSITION_SIZE_METHOD=fixed
POSITION_SIZE_PCT=1.0
MAX_DAILY_LOSS_PCT=5.0
MAX_DRAWDOWN_PCT=15.0
ATR_MULTIPLIER=2.0
TRAILING_STOP=false

# Database
DATABASE_URL=sqlite:///./trading_bot.db

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# App
SECRET_KEY=change-me-in-production
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
